{
  "name": "american-english-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free static American English learning platform",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "release:check": "python3 tools/release_gate.py",
    "qa:sandbox": "AEL_STATIC_HARNESS=1 python3 tests/e2e_playwright.py",
    "qa:audio": "python3 tools/audio_qa.py",
    "qa:examples": "python3 tools/audit_examples.py",
    "test:corpus": "python3 -m unittest discover -s tests -p \"test_*.py\" -v",
    "curriculum:stage": "python3 tools/bulk_curriculum.py --download --allow-network",
    "test:all": "npm test && npm run test:corpus",
    "curriculum:bulk-fast": "python3 tools/fast_source_import.py --download",
    "curriculum:bulk-offline": "python3 tools/fast_source_import.py --offline",
    "curriculum:stage-local": "python3 tools/import_offline_lexicon.py && python3 tools/import_offline_phrasals.py && python3 tools/enrich_candidate_pronunciation.py",
    "curriculum:stage-phrasals": "python3 tools/import_offline_phrasals.py",
    "curriculum:review-queues": "python3 tools/build_curriculum_batches.py",
    "curriculum:build-browser-catalog": "python3 tools/build_research_catalog.py",
    "qa:offline-manifest": "python3 tools/update_offline_manifest.py",
    "curriculum:focus": "python3 tools/curate_daily_spoken_curriculum.py --check",
    "curriculum:quality-check": "python3 tools/curate_daily_spoken_curriculum.py --check && python3 tools/audit_conversational_priority.py",
    "qa:audio-quality": "python3 tools/audio_quality_gate.py",
    "qa:audio-release": "python3 tools/audio_quality_gate.py --release",
    "content:voa-quizzes": "python3 tools/expand_voa_quizzes_20261028.py",
    "content:reading-grammar": "python3 tools/expand_reading_grammar_20261028.py && python3 tools/revise_legacy_reading_distractors_20261028.py && python3 tools/balance_answer_positions.py"
  },
  "license": "MIT"
}
